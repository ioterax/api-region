{
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": "./src",
    "paths": {
      "@/*": [
        "*"
      ],
      "@Helper/*": [
        "src/common/helper/*"
      ]
    },
    "alwaysStrict": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": false,
    "strictBindCallApply": true,
    "strictNullChecks": true,
    "declaration": true,
    "declarationMap": true,
    "removeComments": true,
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "ES2020",
    "incremental": true,
    "skipLibCheck": true,
    "listEmittedFiles": true,
    "esModuleInterop": true,
    // 🔧 ESSENCIAIS PARA COMMONJS
    "module": "CommonJS"
    // "moduleResolution": "node"
  },
  "include": [
    "src/**/*.ts",
  ],
  "exclude": [
    "node_modules",
    "./**/*.spec.ts"
  ]
}