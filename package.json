{
  "name": "@ioterax/api-region",
  "version": "0.1.0",
  "private": true,
  "description": "Private read-only iot.EraX API for governed global countries, administrative divisions, and places.",
  "keywords": [
    "ioterax",
    "regions",
    "geography",
    "mongodb",
    "nestjs",
    "cloud-run",
    "microservice"
  ],
  "author": {
    "name": "Adriano Ferreira",
    "email": "adriano@ioterax.com"
  },
  "license": "UNLICENSED",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": "26.6.0"
  },
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "_moduleAliases": {
    "@": "dist"
  },
  "files": [
    "dist",
    "register-path-alias.cjs"
  ],
  "scripts": {
    "preinstall": "node -e \"const ua=process.env.npm_config_user_agent||'';if(ua.startsWith('npm/')){console.error('Use Yarn for this repository (packageManager: yarn@4.18.0).');process.exit(1)}\"",
    "prebuild": "rimraf dist",
    "build": "yarn exec nest build && node -e \"require('node:fs').accessSync('dist/main.js')\"",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "check:node": "node -e \"const expected='v26.6.0';if(process.version!==expected){console.error('api-region requires Node.js 26.6.0; current: '+process.version);process.exit(1)}\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.{cjs,json,md,mjs,yaml,yml}\" \"docs/**/*.md\" \"scripts/**/*.{cjs,js,mjs}\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.{cjs,json,md,mjs,yaml,yml}\" \"docs/**/*.md\" \"scripts/**/*.{cjs,js,mjs}\" \".github/workflows/*.yml\"",
    "start": "yarn check:node && NODE_OPTIONS=\"${NODE_OPTIONS:-} --require=./register-path-alias.cjs\" yarn exec nest start",
    "start:dev": "yarn check:node && NODE_OPTIONS=\"${NODE_OPTIONS:-} --require=./register-path-alias.cjs\" yarn exec nest start --watch",
    "start:prod": "yarn check:node && NODE_OPTIONS=\"${NODE_OPTIONS:-} --require=./register-path-alias.cjs\" yarn node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "test:mutation": "stryker run",
    "test:pentest": "jest --config ./test/jest-pentest.json --runInBand",
    "test:security:owasp": "bash scripts/security/owasp-dependency-check.sh",
    "indexes:plan": "yarn build && REGION_INDEX_MODE=plan NODE_OPTIONS=\"${NODE_OPTIONS:-} --require=./register-path-alias.cjs\" yarn node dist/scripts/migrate-region-indexes.js",
    "indexes:apply": "yarn build && REGION_INDEX_MODE=apply NODE_OPTIONS=\"${NODE_OPTIONS:-} --require=./register-path-alias.cjs\" yarn node dist/scripts/migrate-region-indexes.js",
    "docs": "compodoc -p tsconfig.json -d documentation --disableSourceCode --disableCoverage --disableGraph --silent",
    "check:dependencies": "knip --include dependencies,devDependencies,unlisted,binaries --strict",
    "check:runtime-deprecations": "node scripts/quality/check-runtime-deprecations.cjs",
    "security:audit": "node scripts/security/audit-dependencies.cjs",
    "quality": "yarn format:check && yarn check:runtime-deprecations && yarn lint && yarn typecheck && yarn build && yarn test:cov && yarn docs && yarn check:dependencies"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.8.0",
    "@ioterax/bootstrap-lib-starter": "3.0.0",
    "@ioterax/foundation-lib-central": "1.1.0",
    "@ioterax/foundation-lib-commons": "1.1.0",
    "@ioterax/foundation-lib-core": "1.0.1",
    "@ioterax/infra-lib-connectivity": "3.0.0",
    "@ioterax/infra-lib-database": "1.1.0",
    "@ioterax/infra-lib-mapper": "2.0.0",
    "@ioterax/infra-lib-profiler": "1.1.0",
    "@ioterax/nestjs-i18n": "11.0.0-ix",
    "@ioterax/observability-lib-metrics": "1.1.0",
    "@ioterax/security-lib-audit": "2.0.0",
    "@ioterax/security-lib-auth": "2.0.0",
    "@ioterax/security-lib-iam": "2.0.0",
    "@ioterax/security-lib-rbac": "1.1.0",
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.2.3",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/typeorm": "^11.0.3",
    "@prometheus-io/client": "0.16.0",
    "@types/express": "5.0.6",
    "amqplib": "^0.10.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "express": "5.2.1",
    "module-alias": "^2.3.4",
    "mongodb": "6.21.0",
    "mongoose": "^9.9.3",
    "nest-winston": "^1.10.2",
    "prom-client": "npm:@prometheus-io/client@0.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "uuid": "11.1.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@compodoc/compodoc": "2.0.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.3",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/jest-runner": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@testcontainers/mongodb": "^12.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "26.4.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "29.7.0",
    "jest-util": "29.7.0",
    "knip": "6.32.2",
    "prettier": "3.9.6",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "testcontainers": "^12.1.0",
    "ts-jest": "29.4.12",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependenciesMeta": {
    "cpu-features@0.0.10": {
      "built": false
    },
    "ssh2@1.17.0": {
      "built": false
    }
  },
  "resolutions": {
    "@angular-devkit/core@npm:19.2.17/ajv": "8.20.0",
    "@angular-devkit/core@npm:19.2.17/picomatch": "4.0.5",
    "ajv@npm:^6.12.5": "6.15.0",
    "ajv@npm:^8.0.0": "8.20.0",
    "ajv@npm:^8.9.0": "8.20.0",
    "@isaacs/brace-expansion": "5.0.1",
    "brace-expansion@npm:^1.1.7": "1.1.18",
    "brace-expansion@npm:^2.0.1": "2.1.4",
    "brace-expansion@npm:^5.0.8": "5.0.9",
    "fast-uri": "3.1.6",
    "glob": "13.0.6",
    "ip-address": "10.5.0",
    "js-yaml@npm:^3.13.1": "3.15.1",
    "js-yaml@npm:^4.1.0": "4.3.1",
    "lodash": "4.18.1",
    "minimatch@npm:^3.0.4": "3.1.4",
    "path-to-regexp": "8.4.2",
    "picomatch@npm:^2.0.4": "2.3.2",
    "picomatch@npm:^2.2.1": "2.3.2",
    "picomatch@npm:^4.0.3": "4.0.7",
    "prom-client@npm:^15.1.3": "npm:@prometheus-io/client@0.16.0",
    "qs": "6.15.3",
    "tar": "7.5.22",
    "test-exclude@npm:^6.0.0": "patch:test-exclude@npm%3A6.0.0#~/.yarn/patches/test-exclude-npm-6.0.0-3fb03d69df.patch",
    "uuid": "11.1.1",
    "@jest/reporters@npm:^29.7.0": "patch:@jest/reporters@npm%3A29.7.0#~/.yarn/patches/@jest-reporters-npm-29.7.0-2561cd7a09.patch",
    "jest-runtime@npm:^29.7.0": "patch:jest-runtime@npm%3A29.7.0#~/.yarn/patches/jest-runtime-npm-29.7.0-120fa64128.patch"
  },
  "knip": {
    "entry": [
      "src/main.ts!",
      "src/scripts/**/*.ts",
      "test/**/*.spec.ts",
      "test/**/*.e2e-spec.ts",
      "register-path-alias.cjs!",
      "scripts/**/*.{cjs,js,mjs}",
      "stryker.config.mjs"
    ],
    "project": [
      "src/**/*.ts!",
      "test/**/*.ts!",
      "scripts/**/*.{cjs,js,mjs}"
    ],
    "ignoreDependencies": [
      "@grpc/grpc-js",
      "@grpc/proto-loader",
      "@ioterax/foundation-lib-core",
      "@ioterax/infra-lib-connectivity",
      "@ioterax/infra-lib-database",
      "@ioterax/infra-lib-profiler",
      "@ioterax/nestjs-i18n",
      "@ioterax/observability-lib-metrics",
      "@ioterax/security-lib-audit",
      "@ioterax/security-lib-iam",
      "@nestjs/config",
      "@nestjs/core",
      "@nestjs/jwt",
      "@nestjs/microservices",
      "@nestjs/mongoose",
      "@nestjs/platform-express",
      "@nestjs/typeorm",
      "@types/express",
      "amqplib",
      "express",
      "jest-util",
      "module-alias",
      "mongoose",
      "nest-winston",
      "prom-client",
      "reflect-metadata",
      "rxjs",
      "typeorm",
      "uuid",
      "winston",
      "winston-daily-rotate-file"
    ],
    "ignoreBinaries": [
      "nest"
    ]
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testMatch": [
      "<rootDir>/test/unit/**/*.spec.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/tsconfig.test.json"
        }
      ]
    },
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/test/setup-env.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/index.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "json",
      "json-summary",
      "lcov",
      "clover"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 91,
        "functions": 91,
        "lines": 91,
        "statements": 91
      }
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/.stryker-tmp/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
