{
  "name": "@ioterax/api-auth",
  "description": "",
  "author": {
    "name": "Adriano Ferreira",
    "email": "adriano@ioterax.com"
  },
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    ".githead"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "yarn nest start",
    "start:dev": "yarn nest start --watch",
    "start:debug": "yarn nest start --debug --watch",
    "start:prod": "yarn node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@ioterax/bootstrap-lib-starter": "<1.0.0",
    "@ioterax/foundation-lib-central": "<1.0.0",
    "@ioterax/foundation-lib-commons": "<1.0.0",
    "@ioterax/foundation-lib-core": "<1.0.0",
    "@ioterax/infra-lib-cache": "<1.0.0",
    "@ioterax/infra-lib-connectivity": "<1.0.0",
    "@ioterax/infra-lib-database": "<1.0.0",
    "@ioterax/infra-lib-mapper": "<1.0.0",
    "@ioterax/infra-lib-profiler": "<1.0.0",
    "@ioterax/observability-lib-metrics": "<1.0.0",
    "@ioterax/security-lib-audit": "<1.0.0",
    "@ioterax/security-lib-auth": "<1.0.0",
    "@ioterax/security-lib-iam": "<1.0.0",
    "@nestjs/common": "^11.1.10",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.10",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.10",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.10",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/typeorm": "^11.0.0",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "amqplib": "^0.10.9",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "express": "^4.19.2",
    "ioredis": "^5.8.2",
    "lz-string": "^1.5.0",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "mongodb": "6.0.0",
    "mongoose": "^9.0.2",
    "nest-winston": "^1.10.2",
    "nestjs-i18n": "^10.6.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.28",
    "uuid": "^9.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.14",
    "@types/node": "^25.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/../src/$1",
      "^@Helper/(.*)$": "<rootDir>/../src/common/helper/$1"
    }
  }
}
