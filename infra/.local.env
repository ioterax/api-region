NODE_ENV=dev
PORT=3000

# DB CONFIG
DATABASE_TYPE=mongodb

# MONGODB
MONGO_USER=local
MONGO_PASSWORD=local
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=laniakeatestdb

# Container -  Local Development Only
CONTAUNER_ENABLE=true
CONTAINER_TYPE=podman # podman | docker | etc
CONTAINER_STOP=false
CONTAINER_REMOVE_VOLUMES=false
CONTAINER_SERVICES=laniakea-db,laniakea-mongodb
