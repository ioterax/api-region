NODE_ENV=local
PORT=3000

# DB CONFIG
DATABASE_TYPE=mongodb

# MONGODB
MONGO_USER=local
MONGO_PASSWORD=local
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=laniakeatestdb

# Container -  Local Development Only
CONTAINER_ENABLE=true
CONTAINER_TYPE=docker # podman | docker | etc
CONTAINER_STOP=true
CONTAINER_REMOVE_VOLUMES= true d
CONTAINER_SERVICES=laniakea-db,laniakea-mongodb
